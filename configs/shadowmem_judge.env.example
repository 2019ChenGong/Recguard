# Client settings for the ShadowMem judge started by scripts/start_vllm_shadowmem_judge.sh.
# Needed only for the ShadowMem baseline (QWEN_DEFENSE=mage).
#     cp configs/shadowmem_judge.env.example configs/shadowmem_judge.env
export MAGE_API_BASE=http://localhost:8010/v1
export MAGE_API_KEY=token-vllm
export MAGE_MODEL=shadowmem-pi-judge
