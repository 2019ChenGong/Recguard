# Client settings for the Qwen3.8-27B server started by scripts/start_vllm_qwen.sh.
# Copy to configs/vllm.env and edit the host / port:
#     cp configs/vllm.env.example configs/vllm.env
export VLLM_API_BASE=http://localhost:8000/v1
export VLLM_API_KEY=token-vllm
export VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
export VLLM_MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
# Transport adapter for native tool schemas (scripts/qwen_native_api.py).
export QWEN_AGENT_MODEL_TYPE=oai_native_tools
export QWEN_AGENT_USE_RAW_API=true
